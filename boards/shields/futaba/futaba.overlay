#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    iqs550_listener: iqs550_listener {
        compatible = "zmk,input-listener";
        device = <&iqs550>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <9>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                                 RC(4,5) RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                 RC(5,5) RC(5,4) RC(5,3) RC(5,2) RC(5,1) RC(5,0)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                                 RC(6,5) RC(6,4) RC(6,3) RC(6,2) RC(6,1) RC(6,0)
                    RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)     RC(8,0) RC(8,1) RC(8,2)             RC(7,5) RC(7,4) RC(7,3) RC(7,2) RC(7,1)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys
            = <&key_physical_attrs 100 100 0 75 500 300 350>
            , <&key_physical_attrs 100 100 100 50 500 300 300>
            , <&key_physical_attrs 100 100 200 25 500 300 250>
            , <&key_physical_attrs 100 100 300 0 500 300 200>
            , <&key_physical_attrs 100 100 400 25 500 300 150>
            , <&key_physical_attrs 100 100 500 50 500 300 100>
            , <&key_physical_attrs 100 100 1000 50 (-500) 1300 250>
            , <&key_physical_attrs 100 100 1100 25 (-500) 1300 300>
            , <&key_physical_attrs 100 100 1200 0 (-500) 1300 350>
            , <&key_physical_attrs 100 100 1300 25 (-500) 1300 400>
            , <&key_physical_attrs 100 100 1400 50 (-500) 1300 450>
            , <&key_physical_attrs 100 100 1500 75 (-500) 1300 500>

            , <&key_physical_attrs 100 100 0 175 500 350 350>
            , <&key_physical_attrs 100 100 100 150 500 350 300>
            , <&key_physical_attrs 100 100 200 125 500 350 250>
            , <&key_physical_attrs 100 100 300 100 500 350 200>
            , <&key_physical_attrs 100 100 400 125 500 350 150>
            , <&key_physical_attrs 100 100 500 150 500 350 100>
            , <&key_physical_attrs 100 100 1000 150 (-500) 1250 250>
            , <&key_physical_attrs 100 100 1100 125 (-500) 1250 300>
            , <&key_physical_attrs 100 100 1200 100 (-500) 1250 350>
            , <&key_physical_attrs 100 100 1300 125 (-500) 1250 400>
            , <&key_physical_attrs 100 100 1400 150 (-500) 1250 450>
            , <&key_physical_attrs 100 100 1500 175 (-500) 1250 500>

            , <&key_physical_attrs 100 100 0 275 500 400 350>
            , <&key_physical_attrs 100 100 100 250 500 400 300>
            , <&key_physical_attrs 100 100 200 225 500 400 250>
            , <&key_physical_attrs 100 100 300 200 500 400 200>
            , <&key_physical_attrs 100 100 400 225 500 400 150>
            , <&key_physical_attrs 100 100 500 250 500 400 100>
            , <&key_physical_attrs 100 100 1000 250 (-500) 1200 250>
            , <&key_physical_attrs 100 100 1100 225 (-500) 1200 300>
            , <&key_physical_attrs 100 100 1200 200 (-500) 1200 350>
            , <&key_physical_attrs 100 100 1300 225 (-500) 1200 400>
            , <&key_physical_attrs 100 100 1400 250 (-500) 1200 450>
            , <&key_physical_attrs 100 100 1500 275 (-500) 1200 500>

            , <&key_physical_attrs 100 100 100 350 500 450 300>
            , <&key_physical_attrs 100 100 200 325 500 450 250>
            , <&key_physical_attrs 100 100 325 350 0 0 0>
            , <&key_physical_attrs 100 100 425 350 700 0 400>
            , <&key_physical_attrs 100 100 525 350 1500 500 400>
            , <&key_physical_attrs 100 100 650 0 0 0 0>
            , <&key_physical_attrs 100 100 750 0 0 0 0>
            , <&key_physical_attrs 100 100 850 0 0 0 0>
            , <&key_physical_attrs 100 100 975 350 (-1500) 1100 400>
            , <&key_physical_attrs 100 100 1075 350 (-700) 1150 400>
            , <&key_physical_attrs 100 100 1175 350 0 0 0>
            , <&key_physical_attrs 100 100 1300 325 (-500) 1150 400>
            , <&key_physical_attrs 100 100 1400 350 (-500) 1150 450>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";

        col-gpios
            = <&pro_micro 15 GPIO_ACTIVE_HIGH>
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

&pinctrl {
    futaba_i2c0_default: futaba_i2c0_default {
        group1 {
            // The PCB routes the trackpad FFC SDA/SCL to nice!nano pads 20/21.
            psels = <NRF_PSEL(TWIM_SDA, 0, 29)>,
                    <NRF_PSEL(TWIM_SCL, 0, 31)>;
        };
    };

    futaba_i2c0_sleep: futaba_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 29)>,
                    <NRF_PSEL(TWIM_SCL, 0, 31)>;
            low-power-enable;
        };
    };
};

&pro_micro_i2c {
    status = "okay";
    clock-frequency = <100000>;
    pinctrl-0 = <&futaba_i2c0_default>;
    pinctrl-1 = <&futaba_i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    // The current PCB only routes SDA/SCL/3V3/GND to the FPC trackpad connector,
    // so the IQS550 is configured without RDY/NRST and uses polling mode.
    iqs550: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        status = "okay";

        one-finger-tap;
        two-finger-tap;
        tap-drag;
        tap-drag-timeout-ms = <300>;

        scroll;
        natural-scroll-x;
        natural-scroll-y;

        bottom-beta = <5>;
        stationary-threshold = <5>;
        switch-xy;
        startup-delay-ms = <1000>;
        startup-probe-timeout-ms = <3000>;
        startup-probe-interval-ms = <250>;
        poll-interval-ms = <20>;
        movement-divisor = <2>;
        scroll-divisor = <24>;
    };
};
