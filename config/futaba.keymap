#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define NAV 1
#define NUM 2
#define L_NUM &lt NUM SPACE
#define R_NUM &lt NUM ENTER
#define L_LANG &mt LSHFT LANG2
#define R_LANG &mt RSHFT LANG1

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB         &kp Q     &kp W     &kp E      &kp R      &kp T             &kp Y      &kp U          &kp I      &kp O         &kp P          &kp BACKSPACE
&kp LEFT_SHIFT  &kp A     &kp S     &kp D      &kp F      &kp G             &kp H      &kp J          &kp K      &kp L         &kp SEMI       &kp SQT
&kp LCTRL       &kp Z     &kp X     &kp C      &kp V      &kp B             &kp N      &kp M          &kp COMMA  &kp DOT       &kp FSLH       &kp EQUAL
                &kp LGUI  &kp LALT  &kp GRAVE  &kp SPACE  &mo NAV  &kp ESC  &kp MINUS  &kp BACKSLASH  &mo 2      &kp KP_ENTER  &kp RIGHT_ALT  &kp LBKT       &kp RBKT
            >;
        };

        nav_layer {
            bindings = <
&trans  &studio_unlock  &trans  &trans  &trans  &trans              &trans      &kp HOME     &kp UP     &kp END    &kp PG_UP  &kp BACKSPACE
&trans  &trans          &trans  &trans  &trans  &trans              &trans      &kp LEFT     &kp DOWN   &kp RIGHT  &kp PG_DN  &kp SQT
&trans  &trans          &trans  &trans  &trans  &trans              &trans      &trans       &kp COMMA  &kp DOT    &kp SLASH  &kp EQUAL
        &trans          &trans  &trans  &trans  &trans  &bt BT_CLR  &sys_reset  &bootloader  &trans     &trans     &trans     &kp BSPC       &trans
            >;
        };

        num_layer {
            bindings = <
&kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT              &kp CARET     &kp AMPS    &kp STAR  &kp LPAR  &kp RPAR  &kp PLUS
&kp GRAVE  &kp N1    &kp N2  &kp N3    &kp N4    &kp N5                 &kp NUMBER_6  &kp N7      &kp N8    &kp N9    &kp N0    &kp EQUAL
&kp F11    &kp F1    &kp F2  &kp F3    &kp F4    &kp F5                 &kp F6        &kp F7      &kp F8    &kp F9    &kp F11   &kp F12
           &trans    &trans  &trans    &trans    &trans     &kp C_PREV  &kp C_PP      &kp C_NEXT  &trans    &trans    &trans    &trans     &trans
            >;
        };
    };
};
